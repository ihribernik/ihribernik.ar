---
import ContentEntryPage from "@/components/ContentEntryPage.astro";
import { entrySlug, publishedEntries } from "@/content/helpers";

export async function getStaticPaths() {
  const entries = await publishedEntries("projects", "es");
  return entries.map((entry) => ({ params: { slug: entrySlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
---
<ContentEntryPage collection="projects" entry={entry} />
